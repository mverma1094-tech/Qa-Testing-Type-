<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Same tests, different browsers and screen sizes. Remove any browser you don't have installed. -->
<suite name="Compatibility Suite" verbose="1">

    <test name="Chrome - Desktop 1920x1080">
        <parameter name="browser" value="chrome"/>
        <parameter name="width" value="1920"/>
        <parameter name="height" value="1080"/>
        <classes><class name="com.manish.qa.ui.compatibility.CrossBrowserCompatibilityTest"/></classes>
    </test>

    <test name="Firefox - Desktop 1920x1080">
        <parameter name="browser" value="firefox"/>
        <parameter name="width" value="1920"/>
        <parameter name="height" value="1080"/>
        <classes><class name="com.manish.qa.ui.compatibility.CrossBrowserCompatibilityTest"/></classes>
    </test>

    <test name="Edge - Desktop 1920x1080">
        <parameter name="browser" value="edge"/>
        <parameter name="width" value="1920"/>
        <parameter name="height" value="1080"/>
        <classes><class name="com.manish.qa.ui.compatibility.CrossBrowserCompatibilityTest"/></classes>
    </test>

    <test name="Chrome - Tablet 768x1024">
        <parameter name="browser" value="chrome"/>
        <parameter name="width" value="768"/>
        <parameter name="height" value="1024"/>
        <classes><class name="com.manish.qa.ui.compatibility.CrossBrowserCompatibilityTest"/></classes>
    </test>

    <test name="Chrome - Mobile 375x812">
        <parameter name="browser" value="chrome"/>
        <parameter name="width" value="375"/>
        <parameter name="height" value="812"/>
        <classes><class name="com.manish.qa.ui.compatibility.CrossBrowserCompatibilityTest"/></classes>
    </test>
</suite>
